# ==============================================================================
# Workspace Demo Environment Template
# Copy this file to .env to deploy Workspace in DEMO MODE on your VPS:
#   cp .env.demo.example .env
#   docker compose up --build -d
# ==============================================================================

# Enable interactive DEMO mode:
# - Provides a 1-click "Explore Demo" login button for visitors.
# - Automatically seeds rich sample reminders, expenses, notes & encrypted secrets.
# - Sandboxes external notifications (simulates email & Telegram dispatches).
# - Disables arbitrary backup restoration to prevent malicious database wiping.
# - Shows a top banner with a "Reset Demo Data" button.
DEMO_MODE=true

# Compose Project Isolation (avoids colliding with an existing production instance)
COMPOSE_PROJECT_NAME=demo-workspace

# Application Environment
NODE_ENV=production

# Network & Host Binding
# Use 0.0.0.0 to expose the port directly to the public internet on your VPS IP,
# or keep 127.0.0.1 if placing Workspace behind a reverse proxy (Caddy / Nginx).
APP_HOST=0.0.0.0
APP_PORT=1234

# Public Base URL
# Replace with your VPS public domain or IP (e.g., https://demo.yourdomain.com or http://YOUR_VPS_IP:1234)
APP_BASE_URL=http://localhost:1234

# Timezone (authoritative for reminders and recurrence)
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=info

# Demo Login Password
# In Demo Mode, visitors can click "Explore Demo" for 1-click sign-in,
# or enter this password manually.
AUTH_PASSWORD=workspace_demo_pass

# Notification Scheduler Settings
NOTIFICATION_SEND_TIME=09:00
NOTIFICATION_POLL_INTERVAL_SECONDS=60
NOTIFICATION_MISSED_GRACE_HOURS=72
NOTIFICATION_MAX_ATTEMPTS=5

# PostgreSQL Container Credentials (used internally by Docker Compose)
POSTGRES_DB=reminder
POSTGRES_USER=reminder
POSTGRES_PASSWORD=demo_postgres_password_secure_2026
DATABASE_URL=postgresql://reminder:demo_postgres_password_secure_2026@db:5432/reminder

# Master encryption key for demo project secrets
SECRETS_MASTER_KEY=workspace_demo_secrets_master_key_2026

# Notification Providers (Mocked / Simulated in Demo Mode)
# In Demo Mode, you DO NOT need real SMTP or Telegram credentials!
# Deliveries and provider tests are simulated safely so you never spam external services.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Workspace Demo <demo@example.com>"
EMAIL_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nightly Backups
TELEGRAM_BACKUP_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
BACKUP_SEND_TIME=02:00

# Optional: Live USD/IRR currency conversion via https://nerkh.io/
NERKH_API_TOKEN=

# Default settings applied on initial database setup
DEFAULT_CALENDAR_SYSTEM=jalali
DEFAULT_CURRENCY=IRR
DEFAULT_EMAIL_ENABLED=true
DEFAULT_TELEGRAM_ENABLED=true
